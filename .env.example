# Copy this file to .env and fill in the values

# Backend API base URL (no trailing slash)
# Dev:        http://localhost:9000/api
# Production: https://api.tripmatch.io/api
EXPO_PUBLIC_API_URL=https://api.tripmatch.io/api

# Sentry DSN (sentry.io → Project Settings → Client Keys → DSN)
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX
